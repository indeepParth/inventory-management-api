# Frontend
VITE_API_BASE_URL=https://api.example.com
FRONTEND_HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=inventorydatabase_prod
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change-this-postgres-password

# Database migrations
Database__ApplyMigrationsOnStartup=false

# JWT
Jwt__Issuer=InventoryManagement
Jwt__Audience=InventoryManagementUsers
Jwt__Key=change-this-to-at-least-32-bytes

# CORS
Cors__AllowedOrigins__0=https://app.example.com

# Reverse proxy
ReverseProxy__KnownNetworks__0=10.0.0.0/8

# Optional first-admin bootstrap
Bootstrap__Admin__Enabled=false
Bootstrap__Admin__UserName=
Bootstrap__Admin__Email=
Bootstrap__Admin__Password=
